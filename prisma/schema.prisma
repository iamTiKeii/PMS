generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id                 String       @id @default(cuid())
  username           String       @unique
  passwordHash       String
  role               String       @default("user") // admin, pm, user
  status             String       @default("active") // active, locked, inactive
  failedAttempts     Int          @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  mustChangePassword Boolean      @default(false)
  staffId            String?      @unique
  staff              Staff?             @relation(fields: [staffId], references: [id], onDelete: SetNull)
  createdLinks       DocLink[]
  auditLogs          AuditLog[]
  createdNotifications Notification[]
  notificationReads  NotificationRead[]
  createdRequests    ProjectRequest[]
  paymentConfig      UserPaymentConfig?
  createdGroupOrders GroupOrder[]       @relation("CreatedGroupOrders")
  groupOrderMembers  GroupOrderMember[]
  groupOrderItems    GroupOrderItem[]
  ownedVaultAccounts   StaffAccount[]     @relation("VaultAccountOwner")
  createdVaultAccounts StaffAccount[]     @relation("VaultAccountCreator")
  vaultSecurity        UserVaultSecurity?
  userRoles            UserRole[]
  userScopes           UserRoleScope[]
  createdSupportTickets   SupportTicket[]    @relation("TicketCreator")
  assignedSupportTickets  SupportTicket[]    @relation("TicketAssignee")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  @@map("system_users")
}

model Staff {
  id                 String              @id @default(cuid())
  fullName           String
  staffCode          String?             @unique
  corporateEmail     String?             @unique
  phoneNumber        String?
  department         String?
  status             String              @default("working") // working, left
  joinDate           DateTime?
  user               User?
  projectAssignments ProjectAssignment[]
  siteAccounts       StaffAccount[]
  requestedRequests  ProjectRequest[]    @relation("RequesterStaff")
  receivedRequests   ProjectRequest[]    @relation("ReceiverStaff")
  followedRequests   RequestFollower[]
  contactProjects    Project[]           @relation("ProjectContactStaff")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?

  @@map("staff")
}

model DocLink {
  id              String    @id @default(cuid())
  title           String    @db.VarChar(500)
  targetUrl       String    @db.Text
  linkCategory    String    @default("other") // docs, sheets, drive, other
  tags            String?   @db.Text // JSON string of tags
  description     String?   @db.Text
  createdByUserId String
  createdByUser   User      @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@map("doc_links")
}

model Region {
  id        String    @id @default(cuid()) @db.VarChar(36)
  code      String    @unique @db.VarChar(50)
  name      String    @unique @db.VarChar(255)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  projects  Project[]

  @@map("regions")
}

model Project {
  id                   String              @id @default(cuid())
  projectCode          String?             @unique
  projectName          String              @unique
  shortName            String?             @unique @map("short_name") @db.VarChar(50) // Prefix mã QLYC (VD: DKCT)
  requestSequence      Int                 @default(0) @map("request_sequence") // Sequence sinh mã QLYC
  systemHisUrl         String
  defaultPassword      String?
  status               String              @default("active") // active, maintenance, closed
  description          String?
  regionId             String?             @map("region_id") @db.VarChar(36)
  region               Region?             @relation(fields: [regionId], references: [id], onDelete: SetNull)
  contactStaffId       String?             @map("contact_staff_id") @db.VarChar(36)
  contactStaffName     String?             @map("contact_staff_name") @db.VarChar(255)
  contactStaffPosition String?             @map("contact_staff_position") @db.VarChar(255)
  contactStaff         Staff?              @relation("ProjectContactStaff", fields: [contactStaffId], references: [id], onDelete: SetNull)
  assignments          ProjectAssignment[]
  siteAccounts         StaffAccount[]
  requests             ProjectRequest[]
  supportTickets       SupportTicket[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?

  @@index([contactStaffId])
  @@index([regionId])
  @@map("projects")
}

model ProjectAssignment {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  staffId      String
  staff        Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  tierLevel    Int // 1: Lead (Bắt buộc), 2: PM (Tùy chọn), 3: Director (Tùy chọn)
  isPrimary    Boolean   @default(true)
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  @@unique([projectId, tierLevel, staffId])
  @@map("project_assignments")
}

model StaffAccount {
  id                    String    @id @default(cuid())
  projectId             String
  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  staffId               String?
  staff                 Staff?    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  accountLabel          String
  siteLoginUsername     String
  sitePasswordEncrypted String
  encryptionIv          String // 12-byte IV in base64
  encryptionAuthTag     String // 16-byte Auth Tag in base64
  status                String    @default("in_use") // in_use, stopped, rotation_needed
  notes                 String?
  url                   String?   @db.Text
  ownerUserId           String?   @map("owner_user_id") @db.VarChar(36)
  ownerUser             User?     @relation("VaultAccountOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdById           String?   @map("created_by") @db.VarChar(36)
  createdByUser         User?     @relation("VaultAccountCreator", fields: [createdById], references: [id], onDelete: SetNull)
  passwordStatus        String    @default("DEFAULT") @map("password_status") @db.VarChar(20) // DEFAULT, CUSTOM
  passwordChangedAt     DateTime? @map("password_changed_at")
  lastRotatedAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  @@index([projectId])
  @@index([staffId])
  @@index([ownerUserId])
  @@index([createdById])
  @@map("staff_accounts")
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actionCode     String
  targetEntity   String
  targetEntityId String?
  contextJson    String?
  ipAddress      String
  userAgent      String?
  createdAt      DateTime @default(now())

  @@map("audit_logs")
}

model Notification {
  id          String    @id @default(cuid()) @db.VarChar(36)
  eventCode   String?   @map("event_code") @db.VarChar(50)
  createdById String?   @map("created_by")
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  type        String    @db.VarChar(50) // sys, project, request, reminder, attendance, security, staff, account
  title       String    @db.VarChar(255)
  content     String    @db.Text
  severity    String    @default("info") @db.VarChar(20) // info, success, warning, important, security
  objectType  String?   @map("object_type") @db.VarChar(50)
  objectId    String?   @map("object_id") @db.VarChar(50)
  targetUrl   String?   @map("target_url") @db.VarChar(1000)
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")
  deletedAt   DateTime? @map("deleted_at")

  reads       NotificationRead[]
  deliveries  NotificationDelivery[]

  @@index([createdAt])
  @@index([type])
  @@index([eventCode])
  @@index([objectType, objectId])
  @@map("notifications")
}

model NotificationRead {
  id             String       @id @default(cuid()) @db.VarChar(36)
  notificationId String       @map("notification_id") @db.VarChar(36)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now()) @map("read_at")

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@map("notification_reads")
}

model NotificationDelivery {
  id                String       @id @default(cuid()) @db.VarChar(36)
  notificationId    String       @map("notification_id") @db.VarChar(36)
  notification      Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel           String       @db.VarChar(30) // web, telegram
  status            String       @default("pending") @db.VarChar(30) // pending, sent, failed
  externalMessageId String?      @map("external_message_id") @db.VarChar(100)
  errorMessage      String?      @db.Text @map("error_message")
  sentAt            DateTime?    @map("sent_at")

  @@index([notificationId])
  @@index([channel, status])
  @@map("notification_deliveries")
}

model TelegramConfig {
  id                String    @id @default(cuid()) @db.VarChar(36)
  botName           String?   @map("bot_name") @db.VarChar(100)
  botUsername       String?   @map("bot_username") @db.VarChar(100)
  botTokenEncrypted String    @db.Text @map("bot_token_encrypted")
  chatId            String    @map("chat_id") @db.VarChar(100)
  chatName          String?   @map("chat_name") @db.VarChar(200)
  enabled           Boolean   @default(true)
  notifyProject     Boolean   @default(true) @map("notify_project")
  notifyStaff       Boolean   @default(true) @map("notify_staff")
  notifyAccount     Boolean   @default(true) @map("notify_account")
  notifySystem      Boolean   @default(true) @map("notify_system")
  lastTestAt        DateTime? @map("last_test_at")
  lastTestStatus    String?   @map("last_test_status") @db.VarChar(50)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("telegram_config")
}

model NotificationSetting {
  id                String   @id @default(cuid()) @db.VarChar(36)
  eventCode         String   @unique @map("event_code") @db.VarChar(50)
  feedEnabled       Boolean  @default(true) @map("feed_enabled")
  telegramEnabled   Boolean  @default(false) @map("telegram_enabled")
  scheduleEnabled   Boolean  @default(false) @map("schedule_enabled")
  scheduleTime      String?  @map("schedule_time") @db.VarChar(20) // VD: 07:50
  remindBeforeDays  Int?     @map("remind_before_days") @default(1)
  skipWeekends      Boolean  @default(true) @map("skip_weekends")
  skipHolidays      Boolean  @default(true) @map("skip_holidays")
  enabled           Boolean  @default(true)
  updatedBy         String?  @map("updated_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("notification_settings")
}

model ReminderLog {
  id           String   @id @default(cuid()) @db.VarChar(36)
  reminderType String   @map("reminder_type") @db.VarChar(50)
  referenceId  String   @map("reference_id") @db.VarChar(100)
  targetDate   String   @map("target_date") @db.VarChar(20)
  sentAt       DateTime @default(now()) @map("sent_at")

  @@unique([reminderType, referenceId, targetDate])
  @@index([reminderType, targetDate])
  @@map("reminder_logs")
}

model HospitalFacility {
  id             String    @id @default(cuid()) @db.VarChar(36)
  code           String    @unique @db.VarChar(50) // Mã CSKCB (VD: 01816)
  name           String    @db.VarChar(255) // Tên bệnh viện / CSKCB
  technicalLine  String?   @map("technical_line") @db.VarChar(100) // Tuyến CMKT
  hospitalRank   String?   @map("hospital_rank") @db.VarChar(100) // Hạng bệnh viện
  technicalLevel String?   @map("technical_level") @db.VarChar(100) // Cấp CMKT
  score          String?   @db.VarChar(50) // Điểm
  address        String?   @db.VarChar(500) // Địa chỉ cơ sở
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([code])
  @@index([name])
  @@map("hospital_facilities")
}

model ProjectRequest {
  id            String            @id @default(cuid()) @db.VarChar(36)
  projectId     String            @map("project_id")
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestCode   String            @unique @map("request_code") @db.VarChar(50) // VD: DKCT00001
  requesterId   String?           @map("requester_id")
  requester     Staff?            @relation("RequesterStaff", fields: [requesterId], references: [id], onDelete: SetNull)
  requesterName String?           @map("requester_name") @db.VarChar(255) // Tên người yêu cầu nếu ngoài danh mục
  department    String?           @db.VarChar(255) // Khoa / phòng
  receiverId    String?           @map("receiver_id")
  receiver      Staff?            @relation("ReceiverStaff", fields: [receiverId], references: [id], onDelete: SetNull)
  content       String            @db.Text // Rich Text HTML/Markdown
  dueDate       DateTime?         @map("due_date") @db.Date // Due Date
  jiraUrl       String?           @map("jira_url") @db.VarChar(2000) // Link Jira
  status        String            @default("pending") @db.VarChar(50) // Trạng thái nếu cần
  createdById   String?           @map("created_by")
  createdByUser User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  followers     RequestFollower[]
  activities    ProjectRequestActivity[]
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")

  @@index([projectId])
  @@index([requestCode])
  @@index([deletedAt])
  @@map("project_requests")
}

model RequestFollower {
  id        String         @id @default(cuid()) @db.VarChar(36)
  requestId String         @map("request_id") @db.VarChar(36)
  request   ProjectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  staffId   String         @map("staff_id")
  staff     Staff          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([requestId, staffId])
  @@map("request_followers")
}

model ProjectRequestActivity {
  id           String         @id @default(cuid()) @db.VarChar(36)
  requestId    String         @map("request_id") @db.VarChar(36)
  request      ProjectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  eventCode    String         @map("event_code") @db.VarChar(50)
  actorId      String?        @map("actor_id") @db.VarChar(50)
  actorName    String?        @map("actor_name") @db.VarChar(255)
  eventTime    DateTime       @default(now()) @map("event_time")
  title        String         @db.VarChar(255)
  description  String?        @db.Text
  metadataJson String?        @map("metadata_json") @db.Text
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([requestId])
  @@index([eventCode])
  @@index([eventTime])
  @@map("project_request_activities")
}

model UserPaymentConfig {
  id             String   @id @default(cuid()) @db.VarChar(36)
  userId         String   @unique @map("user_id") @db.VarChar(36)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankCode       String   @map("bank_code") @db.VarChar(50) // VD: MB, VCB, TCB, ACB
  bankName       String   @map("bank_name") @db.VarChar(100) // Tên ngân hàng
  accountNumber  String   @map("account_number") @db.VarChar(50) // Số tài khoản (chuỗi, giữ nguyên số 0 đầu)
  accountName    String   @map("account_name") @db.VarChar(100) // Tên chủ tài khoản
  branch         String?  @map("branch") @db.VarChar(200) // Chi nhánh
  defaultContent String?  @default("ORDER") @map("default_content") @db.VarChar(100) // Cú pháp chuyển khoản mặc định
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("user_payment_configs")
}

model GroupOrder {
  id            String                       @id @default(cuid()) @db.VarChar(36)
  orderCode     String                       @unique @map("order_code") @db.VarChar(50) // VD: ORD261009001
  title         String                       @db.VarChar(255) // Tên đơn: VD: Order trà sữa chiều 09/10
  description   String?                      @db.Text
  createdById   String                       @map("created_by") @db.VarChar(36) // Trưởng nhóm tạo đơn
  createdByUser User                         @relation("CreatedGroupOrders", fields: [createdById], references: [id], onDelete: Cascade)
  status        String                       @default("open") @db.VarChar(20) // open, closed, completed
  orderDeadline DateTime?                    @map("order_deadline")
  closedAt      DateTime?                    @map("closed_at")
  totalAmount   Int                          @default(0) @map("total_amount") // Tổng tiền của cả đơn
  createdAt     DateTime                     @default(now()) @map("created_at")
  updatedAt     DateTime                     @updatedAt @map("updated_at")
  deletedAt     DateTime?                    @map("deleted_at")

  members       GroupOrderMember[]
  items         GroupOrderItem[]
  reminders     GroupOrderPaymentReminder[]
  activities    GroupOrderActivity[]

  @@index([createdById])
  @@index([status])
  @@index([deletedAt])
  @@map("group_orders")
}

model GroupOrderMember {
  id                String     @id @default(cuid()) @db.VarChar(36)
  groupOrderId      String     @map("group_order_id") @db.VarChar(36)
  groupOrder        GroupOrder @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)
  userId            String     @map("user_id") @db.VarChar(36)
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentStatus     String     @default("pending") @map("payment_status") @db.VarChar(20) // pending, paid
  paidAt            DateTime?  @map("paid_at")
  paidConfirmedById String?    @map("paid_confirmed_by") @db.VarChar(36)
  notes             String?    @db.VarChar(255)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@unique([groupOrderId, userId])
  @@index([groupOrderId])
  @@index([userId])
  @@map("group_order_members")
}

model GroupOrderItem {
  id           String     @id @default(cuid()) @db.VarChar(36)
  groupOrderId String     @map("group_order_id") @db.VarChar(36)
  groupOrder   GroupOrder @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)
  userId       String     @map("user_id") @db.VarChar(36)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemName     String     @map("item_name") @db.VarChar(255)
  quantity     Int        @default(1)
  note         String?    @db.VarChar(255)
  unitPrice    Int?       @map("unit_price") // Đơn giá thực tế trưởng nhóm nhập
  totalAmount  Int?       @map("total_amount") // quantity * unitPrice
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([groupOrderId])
  @@index([userId])
  @@map("group_order_items")
}

model GroupOrderPaymentReminder {
  id                       String     @id @default(cuid()) @db.VarChar(36)
  groupOrderId             String     @map("group_order_id") @db.VarChar(36)
  groupOrder               GroupOrder @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)
  createdById              String     @map("created_by") @db.VarChar(36)
  content                  String     @db.Text
  bankInfo                 String?    @map("bank_info") @db.Text
  qrDataUrl                String?    @map("qr_data_url") @db.Text
  unpaidCount              Int        @default(0) @map("unpaid_count")
  unpaidAmount             Int        @default(0) @map("unpaid_amount")
  telegramMessageId        String?    @map("telegram_message_id") @db.VarChar(100)
  paymentBankCode          String?    @map("payment_bank_code") @db.VarChar(50)
  paymentAccountNumber     String?    @map("payment_account_number") @db.VarChar(50)
  paymentAccountHolderName String?    @map("payment_account_holder_name") @db.VarChar(100)
  paymentBranch            String?    @map("payment_branch") @db.VarChar(200)
  paymentProfileSnapshotAt DateTime?  @map("payment_profile_snapshot_at")
  sentAt                   DateTime   @default(now()) @map("sent_at")
  createdAt                DateTime   @default(now()) @map("created_at")

  @@index([groupOrderId])
  @@map("group_order_payment_reminders")
}

model GroupOrderActivity {
  id           String     @id @default(cuid()) @db.VarChar(36)
  groupOrderId String     @map("group_order_id") @db.VarChar(36)
  groupOrder   GroupOrder @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)
  eventCode    String     @map("event_code") @db.VarChar(50)
  actorId      String?    @map("actor_id") @db.VarChar(50)
  actorName    String?    @map("actor_name") @db.VarChar(255)
  eventTime    DateTime   @default(now()) @map("event_time")
  title        String     @db.VarChar(255)
  description  String?    @db.Text
  metadataJson String?    @map("metadata_json") @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([groupOrderId])
  @@index([eventCode])
  @@index([eventTime])
  @@map("group_order_activities")
}

model UserVaultSecurity {
  id             String    @id @default(cuid()) @db.VarChar(36)
  userId         String    @unique @map("user_id") @db.VarChar(36)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pinHash        String    @map("pin_hash") @db.Text
  pinLength      Int       @map("pin_length") @db.SmallInt // 4 hoặc 6
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  pinUpdatedAt   DateTime? @map("pin_updated_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("user_vault_security")
}

model Role {
  id               String           @id @default(cuid()) @db.VarChar(36)
  code             String           @unique @db.VarChar(50) // admin, pm, member, viewer, custom_...
  name             String           @db.VarChar(100) // Tên vai trò hiển thị
  description      String?          @db.Text // Mô tả trách nhiệm
  isSystem         Boolean          @default(false) @map("is_system") // Vai trò hệ thống không được xóa tùy tiện
  status           String           @default("active") @db.VarChar(20) // active, inactive
  defaultScopeType String           @default("system") @map("default_scope_type") @db.VarChar(50) // system, project, department, assigned, personal
  rolePermissions  RolePermission[]
  userRoles        UserRole[]
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@map("access_roles")
}

model Permission {
  id              String           @id @default(cuid()) @db.VarChar(36)
  code            String           @unique @db.VarChar(100) // projects.list.view, projects.detail.edit, ...
  name            String           @db.VarChar(150) // Nhãn tiếng Việt dễ hiểu
  module          String           @db.VarChar(50) // projects, doc_links, staff, group_orders, vault, access, system
  resource        String           @db.VarChar(50) // list, detail, members, requests, documents, ...
  action          String           @db.VarChar(50) // view, create, edit, delete, manage, export, ...
  description     String?          @db.Text
  isSensitive     Boolean          @default(false) @map("is_sensitive") // Cờ quyền nhạy cảm (xóa dữ liệu, cấp quyền, cấu hình)
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([module])
  @@map("access_permissions")
}

model RolePermission {
  id           String     @id @default(cuid()) @db.VarChar(36)
  roleId       String     @map("role_id") @db.VarChar(36)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id") @db.VarChar(36)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("access_role_permissions")
}

model UserRole {
  id         String   @id @default(cuid()) @db.VarChar(36)
  userId     String   @map("user_id") @db.VarChar(36)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String   @map("role_id") @db.VarChar(36)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy String?  @map("assigned_by") @db.VarChar(36)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("access_user_roles")
}

model UserRoleScope {
  id         String   @id @default(cuid()) @db.VarChar(36)
  userId     String   @map("user_id") @db.VarChar(36)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopeType  String   @map("scope_type") @db.VarChar(50) // system, project, department, assigned, personal
  targetId   String?  @map("target_id") @db.VarChar(100) // ID của project hoặc tên department nếu theo cụ thể
  targetName String?  @map("target_name") @db.VarChar(255) // Tên hiển thị (Tên dự án hoặc phòng ban)
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([scopeType])
  @@map("access_user_scopes")
}

model AccessAuditLog {
  id             String   @id @default(cuid()) @db.VarChar(36)
  actorId        String?  @map("actor_id") @db.VarChar(36)
  actorUsername  String?  @map("actor_username") @db.VarChar(100)
  actorName      String?  @map("actor_name") @db.VarChar(255)
  action         String   @db.VarChar(100) // assign_role, revoke_role, update_role_permissions, update_scope, ...
  targetType     String   @map("target_type") @db.VarChar(50) // user, role, permission, scope
  targetId       String?  @map("target_id") @db.VarChar(50)
  targetName     String?  @map("target_name") @db.VarChar(255)
  summary        String   @db.Text
  beforeDataJson String?  @map("before_data_json") @db.Text
  afterDataJson  String?  @map("after_data_json") @db.Text
  ipAddress      String?  @map("ip_address") @db.VarChar(50)
  userAgent      String?  @map("user_agent") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([targetType])
  @@index([action])
  @@index([createdAt])
  @@map("access_audit_logs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Module: Ghi nhận Hỗ trợ (Support Tickets)
// ═══════════════════════════════════════════════════════════════════════════════

/// Danh mục nghiệp vụ (VD: Khám bệnh, Viện phí, BHXH, Dược, Xét nghiệm...)
model SupportBusiness {
  id        String   @id @default(cuid()) @db.VarChar(36)
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(150)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tickets SupportTicket[]

  @@index([isActive, sortOrder])
  @@map("support_businesses")
}

/// Danh mục phương thức hỗ trợ (VD: Zalo, Hotline, Remote, TeamViewer, Tại chỗ...)
model SupportMethod {
  id        String   @id @default(cuid()) @db.VarChar(36)
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(150)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ticketMethods SupportTicketMethod[]

  @@index([isActive, sortOrder])
  @@map("support_methods")
}

/// Danh mục loại hỗ trợ / khai báo (VD: Lỗi phần mềm, Cấu hình, Đào tạo, Yêu cầu mới...)
model SupportType {
  id        String   @id @default(cuid()) @db.VarChar(36)
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(150)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tickets SupportTicket[]

  @@index([isActive, sortOrder])
  @@map("support_types")
}

/// Cấu hình ngưỡng phân nhóm thời gian xử lý (VD: <15 phút, 15-30 phút, ≥30 phút)
model SupportTimeGroup {
  id         String   @id @default(cuid()) @db.VarChar(36)
  code       String   @unique @db.VarChar(50)
  name       String   @db.VarChar(150) // VD: "Dưới 15 phút"
  minSeconds Int      @map("min_seconds") // Giới hạn dưới (inclusive), tính bằng giây
  maxSeconds Int?     @map("max_seconds") // Giới hạn trên (exclusive), null = không giới hạn
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tickets SupportTicket[]

  @@index([isActive, sortOrder])
  @@map("support_time_groups")
}

/// Bản ghi chính ca hỗ trợ
model SupportTicket {
  id                String    @id @default(cuid()) @db.VarChar(36)
  ticketCode        String    @unique @map("ticket_code") @db.VarChar(20) // HT-00001
  projectId         String    @map("project_id") @db.VarChar(36)
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requesterName     String    @map("requester_name") @db.VarChar(255) // Người dùng yêu cầu hỗ trợ (text)
  createdById       String    @map("created_by") @db.VarChar(36)
  createdByUser     User      @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignedUserId    String    @map("assigned_user_id") @db.VarChar(36)
  assignedUser      User      @relation("TicketAssignee", fields: [assignedUserId], references: [id], onDelete: Cascade)
  businessId        String    @map("business_id") @db.VarChar(36)
  business          SupportBusiness @relation(fields: [businessId], references: [id])
  description       String    @db.Text // Mô tả vấn đề
  cause             String?   @db.Text // Nguyên nhân
  resolution        String?   @db.Text // Cách xử lý
  sentAt            DateTime  @map("sent_at") // Thời điểm người dùng gửi yêu cầu
  receivedAt        DateTime? @map("received_at") // Thời điểm nhân sự tiếp nhận
  resolvedAt        DateTime? @map("resolved_at") // Thời điểm hoàn thành
  processingSeconds Int?      @map("processing_seconds") // T_xử_lý = resolvedAt - receivedAt (giây)
  totalSeconds      Int?      @map("total_seconds") // T_tổng = resolvedAt - sentAt (giây)
  timeGroupId       String?   @map("time_group_id") @db.VarChar(36)
  timeGroup         SupportTimeGroup? @relation(fields: [timeGroupId], references: [id])
  supportTypeId     String?   @map("support_type_id") @db.VarChar(36)
  supportType       SupportType? @relation(fields: [supportTypeId], references: [id])
  status            String    @default("IN_PROGRESS") @db.VarChar(20) // IN_PROGRESS, COMPLETED
  version           Int       @default(1) // Optimistic locking
  idempotencyKey    String?   @unique @map("idempotency_key") @db.VarChar(64) // Chống tạo trùng
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  methods SupportTicketMethod[]
  history SupportTicketHistory[]

  @@index([projectId])
  @@index([assignedUserId])
  @@index([createdById])
  @@index([businessId])
  @@index([supportTypeId])
  @@index([timeGroupId])
  @@index([status])
  @@index([sentAt])
  @@index([ticketCode])
  @@map("support_tickets")
}

/// Liên kết nhiều phương thức hỗ trợ với một ca (M:N pivot)
model SupportTicketMethod {
  id       String        @id @default(cuid()) @db.VarChar(36)
  ticketId String        @map("ticket_id") @db.VarChar(36)
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  methodId String        @map("method_id") @db.VarChar(36)
  method   SupportMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)

  @@unique([ticketId, methodId])
  @@index([ticketId])
  @@index([methodId])
  @@map("support_ticket_methods")
}

/// Lịch sử tạo, sửa, chuyển trạng thái, phân công ca hỗ trợ
model SupportTicketHistory {
  id          String        @id @default(cuid()) @db.VarChar(36)
  ticketId    String        @map("ticket_id") @db.VarChar(36)
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorUserId String        @map("actor_user_id") @db.VarChar(36)
  actorName   String?       @map("actor_name") @db.VarChar(255)
  action      String        @db.VarChar(50) // created, updated, completed, reopened, assigned, status_changed
  beforeData  String?       @map("before_data") @db.Text // JSON trước thay đổi
  afterData   String?       @map("after_data") @db.Text // JSON sau thay đổi
  reason      String?       @db.Text // Lý do (bắt buộc khi mở lại ca)
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([ticketId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
  @@map("support_ticket_history")
}

/// Lịch sử thay đổi danh mục Master Data hỗ trợ
model SupportMasterDataHistory {
  id             String   @id @default(cuid()) @db.VarChar(36)
  masterDataType String   @map("master_data_type") @db.VarChar(50) // business, method, type, time_group
  recordId       String   @map("record_id") @db.VarChar(36)
  actorUserId    String   @map("actor_user_id") @db.VarChar(36)
  actorName      String?  @map("actor_name") @db.VarChar(255)
  beforeData     String?  @map("before_data") @db.Text
  afterData      String?  @map("after_data") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([masterDataType, recordId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("support_master_data_history")
}
