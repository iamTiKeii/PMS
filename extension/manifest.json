{
  "manifest_version": 3,
  "name": "ISOFH Support",
  "version": "1.0.0",
  "description": "Tiện ích ghi nhận ca hỗ trợ kỹ thuật trực ca cho nhân sự ISOFH trên thanh bên trình duyệt (Side Panel).",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "ISOFH Support (Mở thanh bên Side Panel)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
